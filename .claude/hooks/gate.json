{
  "targets": [
    {
      "name": "前端",
      "dir": ".",
      "run": "npm run check:rules && npm run build",
      "watch": ["src", "public", "scripts", "index.html", "vite.config.ts", "package.json", "package-lock.json", "tsconfig.json", "tsconfig.app.json", "tsconfig.node.json"]
    },
    {
      "name": "後端",
      "dir": "../Tarot-backend",
      "run": "npm test",
      "watch": ["src", "test", "scripts", "package.json", "package-lock.json"]
    }
  ]
}
